{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "upload": {
    "rules": [
      {
        "type": "Text",
        "globs": ["**/*.md", "**/*.txt"]
      }
    ],
    "exclude": [
      "edição/**",
      "*.xcf",
      "*Copia*",
      "index*.html",
      "!index.html",
      ".git/**"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
